{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/hostguard/policy/v1",
  "title": "Wellmanifest hostguard policy document v1",
  "description": "Canonical host-threat policy. Propose-only: the document never probes a host or authorizes a kill or block. Implementing products are subactor/hostguard (resources) and subactor/guard-agent (security holes, notify, granted block).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "probe", "policy", "allowlist", "thresholds", "classifications", "questions"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema": { "const": "wellmanifest.hostguard/policy/v1" },
    "id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semver" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 400 },
    "probe": { "$ref": "#/$defs/probe" },
    "policy": { "$ref": "#/$defs/policy" },
    "allowlist": {
      "type": "array",
      "items": { "$ref": "#/$defs/allowlistEntry" }
    },
    "inUse": { "$ref": "#/$defs/inUse" },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "classifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/classification" }
    },
    "questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "scope": {
      "enum": ["host", "container", "docker-engine"]
    },
    "signal": {
      "enum": [
        "cpu",
        "ram",
        "storage",
        "power",
        "fd",
        "inode",
        "zombie",
        "fork_bomb",
        "runaway",
        "listener",
        "docker_sock",
        "docker_privileged",
        "cap_escalation",
        "unknown_binary",
        "crypto_miner"
      ]
    },
    "kind": {
      "enum": [
        "inventory_vs_runtime",
        "served_artifact",
        "capability_surface",
        "allowlisted_instance",
        "guardian_self",
        "init_pid",
        "runaway_process",
        "resource_pressure",
        "fork_bomb",
        "zombie_storm",
        "probe_noise",
        "unknown_process",
        "suspicious_process",
        "unexpected_listener",
        "docker_socket_exposure",
        "docker_privileged",
        "capability_escalation",
        "unknown_binary",
        "crypto_miner_pattern"
      ]
    },
    "actionDo": {
      "enum": [
        "observe",
        "warn",
        "write_ticket",
        "ticket",
        "escalate",
        "notify_founder",
        "propose_kill",
        "refuse_kill",
        "propose_block",
        "refuse_block",
        "block",
        "ask_clarifying_questions",
        "classify_before_threat",
        "probe_live_host",
        "require_kill_grant",
        "require_block_grant",
        "skip_in_use_tool",
        "ignore_probe_noise"
      ]
    },
    "forbidDo": {
      "enum": [
        "kill_without_grant",
        "kill_pid_1",
        "kill_guardian_self",
        "kill_allowlisted_instance",
        "block_without_grant",
        "block_pid_1",
        "block_guardian_self",
        "block_allowlisted_instance",
        "block_in_use_tool",
        "treat_top_as_threat",
        "treat_in_use_tool_as_threat",
        "treat_editor_as_host",
        "treat_visible_kill_as_grant",
        "treat_visible_block_as_grant",
        "treat_probe_noise_as_debt",
        "mount_docker_sock_rw_by_default"
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalSeconds", "source", "signals"],
      "properties": {
        "intervalSeconds": { "type": "integer", "minimum": 5, "maximum": 86400 },
        "source": { "enum": ["live-host", "injected-snapshot"] },
        "signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/signal" }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scope" }
        },
        "dockerSock": {
          "enum": ["none", "read-only"],
          "description": "RW docker.sock is not a valid default. Host-inspect from the developer system is preferred over mounting the socket into app containers."
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknownPolicy", "effectModel", "defaultAction", "escalation", "kill", "forbid"],
      "properties": {
        "unknownPolicy": { "const": "reject" },
        "effectModel": { "const": "observe-default" },
        "defaultAction": { "const": "observe" },
        "escalation": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["observe", "warn", "ticket", "notify_founder", "block", "escalate"] }
        },
        "kill": { "$ref": "#/$defs/kill" },
        "block": { "$ref": "#/$defs/block" },
        "notify": { "$ref": "#/$defs/notify" },
        "forbid": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/forbidDo" }
        }
      }
    },
    "kill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "granted", "never"],
      "properties": {
        "capability": { "const": "capability://hostguard/kill/v1" },
        "granted": { "type": "boolean" },
        "never": {
          "type": "array",
          "minItems": 3,
          "items": { "enum": ["pid:1", "guardian_self", "allowlisted_instance", "in_use_tool"] }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "granted", "never"],
      "properties": {
        "capability": { "const": "capability://hostguard/block/v1" },
        "granted": { "type": "boolean" },
        "never": {
          "type": "array",
          "minItems": 4,
          "items": { "enum": ["pid:1", "guardian_self", "allowlisted_instance", "in_use_tool"] }
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "channels", "payloadSchema"],
      "properties": {
        "audience": { "const": "founder" },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["browser-push", "desktop"] }
        },
        "payloadSchema": { "const": "wellmanifest.hostguard/founder-notify/v1" }
      }
    },
    "inUse": {
      "type": "object",
      "additionalProperties": false,
      "description": "Runtime tools currently used must not be classified as threats until interview/policy says so (inventory vs runtime; chrome vs grant).",
      "properties": {
        "comms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "images": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "skipUntilInterview": { "type": "boolean" }
      }
    },
    "allowlistEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["comm", "cgroup", "pid", "image", "tool", "path", "exe"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpuPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "ramPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "storagePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "powerWatts": { "type": "number", "minimum": 0 },
        "fdCount": { "type": "integer", "minimum": 0 },
        "inodePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "zombieCount": { "type": "integer", "minimum": 0 },
        "forkRate": { "type": "integer", "minimum": 0 }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "actions", "forbid"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/kind" },
        "scope": { "$ref": "#/$defs/scope" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 800 },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["do"],
            "properties": {
              "do": { "$ref": "#/$defs/actionDo" }
            }
          }
        },
        "forbid": {
          "type": "array",
          "items": { "$ref": "#/$defs/forbidDo" }
        },
        "questions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  }
}
