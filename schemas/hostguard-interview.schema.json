{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/hostguard/interview/v1",
  "title": "Wellmanifest hostguard interview answers v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject_id",
    "purpose",
    "host_kind",
    "probe_interval_seconds",
    "signals",
    "probe_source",
    "kill_granted",
    "visible_kill_control",
    "treat_top_as_threat",
    "analyzer_or_top_noise"
  ],
  "properties": {
    "schema": { "const": "wellmanifest.hostguard/interview/v1" },
    "subject_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 400 },
    "host_kind": { "enum": ["linux-generic", "container", "vm"] },
    "probe_interval_seconds": { "type": "integer", "minimum": 5, "maximum": 86400 },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["cpu", "ram", "storage", "power", "fd", "inode", "zombie", "fork_bomb", "runaway"]
      }
    },
    "probe_source": { "enum": ["live-host", "injected-snapshot"] },
    "allowlist_comms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "instance_cgroups": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "kill_granted": { "type": "boolean" },
    "visible_kill_control": { "type": "boolean" },
    "treat_top_as_threat": { "type": "boolean" },
    "analyzer_or_top_noise": { "type": "boolean" }
  }
}
