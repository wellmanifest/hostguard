{
  "schema": "wellmanifest.hostguard/interview/v1",
  "subject_id": "linux.dev.docker",
  "purpose": "Classify security holes and suspicious processes on a developer host and in Docker.",
  "host_kind": "linux-generic",
  "probe_interval_seconds": 30,
  "signals": ["cpu", "ram", "listener", "docker_sock", "docker_privileged", "cap_escalation", "unknown_binary", "crypto_miner"],
  "probe_source": "injected-snapshot",
  "scopes": ["host", "container", "docker-engine"],
  "docker_sock_policy": "none",
  "allowlist_comms": ["systemd", "sshd"],
  "allowlist_images": ["nginx:alpine"],
  "in_use_tools": ["cursor", "bash", "zsh", "dockerd", "containerd"],
  "treat_in_use_as_threat": false,
  "kill_granted": false,
  "block_granted": false,
  "visible_kill_control": false,
  "visible_block_control": false,
  "notify_founder": true,
  "notify_channels": ["browser-push", "desktop"],
  "audience": "founder",
  "treat_top_as_threat": false,
  "analyzer_or_top_noise": false
}
